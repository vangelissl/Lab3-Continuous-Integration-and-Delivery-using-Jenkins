@Library('cicd-library') _


pipeline {


    agent any


    environment {

        IMAGE = "mariastashenko/nodedev:v1.0"

        CONTAINER = "nodedev-container"

    }



    stages {


        stage('Docker Login') {


            steps {


                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub',
                        usernameVariable: 'USERNAME',
                        passwordVariable: 'PASSWORD'
                    )
                ]) {


                    sh '''
                    echo "$PASSWORD" | docker login \
                    -u "$USERNAME" \
                    --password-stdin
                    '''

                }


            }

        }



        stage('Deploy') {


            steps {


                dockerDeploy(
                    IMAGE,
                    CONTAINER,
                    "3001"
                )


            }

        }


    }



    post {


        always {


            sh 'docker logout || true'


        }


    }


}