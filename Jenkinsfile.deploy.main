@Library('cicd-library') _


pipeline {


    agent any


    environment {

        IMAGE = "mariastashenko/nodemain:v1.0"

        CONTAINER = "nodemain-container"

    }



    stages {


        stage('Docker Login') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub',
                        usernameVariable: 'USERNAME',
                        passwordVariable: 'PASSWORD'
                    )
                ]) {


                    sh '''
                    echo "$PASSWORD" | docker login \
                    -u "$USERNAME" \
                    --password-stdin
                    '''

                }

            }

        }



        stage('Deploy') {

            steps {

                dockerDeploy(
                    IMAGE,
                    CONTAINER,
                    "3000"
                )

            }

        }


    }


    post {

        always {

            sh 'docker logout || true'

        }

    }


}